@using GadeiasBar.WebApp.Modulos.ModuloPedido

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Pedido";
}

@model EditarPedidoViewModel

<div class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;">
    <h1 class="mb-4 text-primary">@ViewBag.Titulo</h1>

    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <form asp-action="Editar" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Produto.Id" class="form-label fw-semibold text-primary text-uppercase small">
                Produto
            </label>

            <select asp-for="Produto.Id" class="form-select">
                <option value="">Selecione o produto</option>
                @if (ViewBag.Produtos != null)
                {
                    @foreach (var produto in ViewBag.Produtos)
                    {
                        <option value="@produto.Id">
                            @produto.Nome - @produto.Preco.ToString("C")
                        </option>
                    }
                }
            </select>

            <span asp-validation-for="Produto.Id" class="text-danger small fw-semibold"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Quantidade" class="form-label fw-semibold text-primary text-uppercase small">
                Quantidade
            </label>

            <input asp-for="Quantidade" type="number" min="1" class="form-control">

            <span asp-validation-for="Quantidade" class="text-danger small fw-semibold"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">
                Voltar
            </a>

            <button class="btn btn-primary rounded-pill px-4" type="submit">
                Confirmar
            </button>
        </div>
    </form>
</div>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Contas";
}

@model List<ListarContaViewModel>

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar</a>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">@mensagemErro</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Nenhuma conta cadastrada.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-2">
        @foreach (ListarContaViewModel conta in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <h5 class="card-title mb-0">Cliente: @conta.NomeCliente</h5>
                            <span class="badge text-bg-primary rounded-pill">@conta.Id.ToString().Substring(0, 8)</span>
                        </div>
                        <dl class="row g-2 mb-4">
                            <dt class="col-sm-4 text-secondary fw-semibold">Garçom</dt>
                            <dd class="col-sm-8 mb-0">@conta.Garcom</dd>

                            <dt class="col-sm-4 text-secondary fw-semibold">Nº da Mesa</dt>
                            <dd class="col-sm-8 mb-0">@conta.Mesa</dd>

                            <dt class="col-sm-4 text-secondary fw-semibold">Data de Abertura</dt>
                            <dd class="col-sm-8 mb-0">@conta.DataDeAbertura</dd>

                            @if (conta.DataDeFechamento is not null)
                            {
                                <dt class="col-sm-4 text-secondary fw-semibold">Data de Fechamento</dt>
                                <dd class="col-sm-8 mb-0">@conta.DataDeAbertura</dd>
                            }

                            <dt class="col-sm-4 text-secondary fw-semibold">Valor Total</dt>
                            <dd class="col-sm-8 mb-0">R$ @conta.ValorFinal</dd>
                        </dl>
                        <div class="d-flex flex-wrap gap-2 mt-auto justify-content-end">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar"
                               asp-route-id="@conta.Id">Editar</a>
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Excluir"
                               asp-route-id="@conta.Id">Excluir</a>
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Visualizar"
                               asp-route-id="@conta.Id">Visualizar</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
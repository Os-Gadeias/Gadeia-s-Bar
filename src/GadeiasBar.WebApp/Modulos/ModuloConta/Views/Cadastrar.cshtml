@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Conta";

}

@model CadastrarContaViewModel;
<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Cadastrar"
      method="post">
    <div class="mb-3">
        <label asp-for="NomeCliente" class="form-label fw-semibold text-primary text-uppercase small">Nome
            Cliente</label>
            <input asp-for="NomeCliente" type="text" class="form-control">
            <span asp-validation-for="NomeCliente" class="text-danger small fw-semibold"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Mesa" class="form-label fw-semibold text-primary text-uppercase small">Selecione a Mesa</label>
            <select class="form-control" asp-for="Mesa" asp-items="ViewBag.Mesas">
                <option value="">Selecione Uma Mesa</option>
            </select>
            <span asp-validation-for="Mesa" class="text-danger small fw-semibold"></span>

        </div>
        <label asp-for="Garcom" class="form-label fw-semibold text-primary text-uppercase small">Selecione o Garçom</label>
        <select class="form-control" asp-for="Garcom" asp-items="ViewBag.Garcons">
            <option value="">Selecione Um Garçom</option>
        </select>
        <span asp-validation-for="Garcom" class="text-danger small fw-semibold"></span>

    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
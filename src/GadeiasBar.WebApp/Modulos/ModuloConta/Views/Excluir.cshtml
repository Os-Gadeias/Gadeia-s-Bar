@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Conta";
}

@model ExcluirContaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden">

    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Deseja realmente excluir esta Conta?
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">ID</dt>
        <dd class="col-sm-8 text-break">@Model.Id</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Nome Cliente</dt>
        <dd class="col-sm-8">@Model.NomeCliente</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Nome Garçom</dt>
        <dd class="col-sm-8">@Model.Garcom</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Número da Mesa</dt>
        <dd class="col-sm-8">@Model.Mesa</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Data de Abertura</dt>
        <dd class="col-sm-8">R$@Model.DataDeAbertura</dd>

        @if (Model.DataDeFechamento is not null)
        {
            <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Data de Abertura</dt>
            <dd class="col-sm-8">R$@Model.DataDeFechamento</dd>
        }

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Status Conta</dt>
        <dd class="col-sm-8">@Model.StatusConta</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Valor Total</dt>
        <dd class="col-sm-8">R$@Model.ValorFinal</dd>
        
    </dl>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
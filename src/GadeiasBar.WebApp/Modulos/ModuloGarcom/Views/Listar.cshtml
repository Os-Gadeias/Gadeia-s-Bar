@using GadeiasBar.WebApp.Modulos.ModuloGarcom
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Garçons";
}

@model List<ListarGarcomViewModels>

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar</a>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">@mensagemErro</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Nenhum garçom cadastrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-4 g-2">
        @foreach (ListarGarcomViewModels garcom in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <h5 class="card-title mb-0">@garcom.Nome</h5>
                            <span class="badge text-bg-primary rounded-pill">@garcom.Id.ToString().Substring(0, 8)</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-auto justify-content-end">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar"
                               asp-route-id="@garcom.Id">Editar</a>
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Excluir"
                               asp-route-id="@garcom.Id">Excluir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
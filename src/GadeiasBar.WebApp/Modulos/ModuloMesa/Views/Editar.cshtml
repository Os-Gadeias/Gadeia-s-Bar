@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Produto";
}

@model EditarMesaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar"
      asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden">

    <div class="mb-3">
        <label asp-for="NumeroMesa" class="form-label fw-semibold text-primary text-uppercase small">Numero da
            mesa</label>
            <input asp-for="NumeroMesa" type="text" class="form-control">
            <span asp-validation-for="NumeroMesa" class="text-danger small fw-semibold"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StatusMesa" class="form-label fw-semibold text-primary text-uppercase small">Tipo
                Produto</label>
                <select asp-for="StatusMesa" class="form-select">
                    <option value="@StatusMesa.Livre">Livre</option>
                    <option value="@StatusMesa.Ocupada">Ocupada</option>
                </select>
                <span asp-validation-for="StatusMesa" class="text-danger small fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="QuantidadeLugares" class="form-label fw-semibold text-primary text-uppercase small">Quantidade
                    de lugares</label>
                    <input asp-for="QuantidadeLugares" type="number" min="1" class="form-control">
                    <span asp-validation-for="QuantidadeLugares" class="text-danger small fw-semibold"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
                    <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
                </div>
            </form>

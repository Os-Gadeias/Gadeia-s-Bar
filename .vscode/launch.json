{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Depurar GadeiasBar.WebApp",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/GadeiasBar.WebApp/bin/Debug/net10.0/GadeiasBar.WebApp.dll",
            "cwd": "${workspaceFolder}/src/GadeiasBar.WebApp",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "launchBrowser": true,
            "launchUrl": "",
            "preLaunchTask": "build GadeiasBar.WebApp",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ]
}